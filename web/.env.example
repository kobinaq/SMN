# Production: set to your real origin (https://….vercel.app or custom domain).
# Required for staff cookies / server functions on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show Agency in the nav, footer, and homepage, and allow /agency to be indexed.
# Leave unset (or any value other than true) to keep the page built but hidden.
# NEXT_PUBLIC_AGENCY_ENABLED=true
NEXT_PUBLIC_WHATSAPP_INVITE=https://chat.whatsapp.com/your-invite
# Ahrefs Web Analytics (public site key — safe in NEXT_PUBLIC_*)
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
OPS_EMAIL=hello@example.com
RESEND_API_KEY=
RESEND_FROM=Think Social Academy <noreply@yourdomain.com>
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Enquiry notifications. All optional. Names only; do not commit real addresses.
# Submissions are stored even when these are unset. A per-type variable overrides
# ENQUIRY_NOTIFY_EMAIL for that type. Mailchimp runs for newsletter signups only
# when MAILCHIMP_API_KEY, MAILCHIMP_AUDIENCE_ID, and MAILCHIMP_SERVER_PREFIX are set.
ENQUIRY_NOTIFY_EMAIL=
ENQUIRY_NOTIFY_EMAIL_PROGRAMME_SOCIAL_MEDIA_MARKETING=
ENQUIRY_NOTIFY_EMAIL_ONE_ON_ONE_TRAINING=
ENQUIRY_NOTIFY_EMAIL_ORGANISATIONAL_TRAINING=
ENQUIRY_NOTIFY_EMAIL_PARTNERSHIP=
ENQUIRY_NOTIFY_EMAIL_CONTACT=
ENQUIRY_NOTIFY_EMAIL_NEWSLETTER=

# Sender confirmation emails. On by default; set a type to false, 0, off or no to
# disable it. Sending needs both RESEND_API_KEY and RESEND_FROM.
ENQUIRY_CONFIRM_PROGRAMME_SOCIAL_MEDIA_MARKETING=
ENQUIRY_CONFIRM_ONE_ON_ONE_TRAINING=
ENQUIRY_CONFIRM_ORGANISATIONAL_TRAINING=
ENQUIRY_CONFIRM_PARTNERSHIP=
ENQUIRY_CONFIRM_CONTACT=
ENQUIRY_CONFIRM_NEWSLETTER=

# Required on Vercel (use a long random string — do not commit real secrets)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Database
# Local SQLite (default):
# DATABASE_URL=file:./payload.db
# Production Postgres (Neon / Supabase):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# On Vercel without a remote DB, public pages use seed content.
# Member auth needs a durable DB (Postgres recommended for production).

# Force seed content for marketing pages even if a DB is configured
# USE_SEED_CONTENT=true

# Cloudflare R2 (optional locally; recommended in production for Media)
# R2_BUCKET=smn-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_PUBLIC_URL=https://media.yourdomain.com

# Secures the daily Vercel opportunity import (use 16+ random characters)
CRON_SECRET=

# Provider-independent AI (disabled until explicitly configured)
AI_PROVIDER=disabled
GROQ_API_KEY=
AI_TEXT_MODEL=llama-3.3-70b-versatile
AI_FAST_MODEL=llama-3.1-8b-instant
AI_STRUCTURED_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=12000
AI_HOURLY_REQUESTS=30
AI_USAGE_RETENTION_DAYS=30
AI_TUTOR_ENABLED=false
AI_CONTENT_STUDIO_ENABLED=false
AI_CAREER_COACH_ENABLED=false
# Optional live-provider test; keep unset in normal CI
# RUN_GROQ_INTEGRATION=true
# One-time existing-database migration adoption guard; never persist in production
# ALLOW_MIGRATION_BASELINE=true

# Emergency only: restore Payload admin UI at /admin
# STAFF_LEGACY_ADMIN=true
